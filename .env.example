# Required. URL-safe secret, at least 24 characters. Keeps the private access link valid across restarts.
# On Railway, use the template function: ${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_")}}
# Local generation: node -e "process.stdout.write(require('crypto').randomBytes(24).toString('base64url'))"
MCPJAM_SESSION_TOKEN=replace-with-a-random-url-safe-secret

# Required. Comma-separated hostnames allowed to open the Inspector (no scheme, no port).
# On Railway, use: ${{RAILWAY_PUBLIC_DOMAIN}}
MCPJAM_ALLOWED_HOSTS=your-domain.example.com

# Required. Full public origin used in access links and origin validation.
# On Railway, use: https://${{RAILWAY_PUBLIC_DOMAIN}}
MCPJAM_INSPECTOR_FRONTEND_URL=https://your-domain.example.com

# Recommended. Disables model-driven local shell/computer tools inside the container.
MCPJAM_LOCAL_COMPUTER_ENABLED=false

# Recommended. Disables local agent browser tools inside the container.
MCPJAM_LOCAL_BROWSER_ENABLED=false

# Optional. Set true only when MCPJAM_ALLOWED_HOSTS contains a wildcard domain.
MCPJAM_ALLOW_WILDCARD_ORIGINS=false
